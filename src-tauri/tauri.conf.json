{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SymNote",
  "version": "0.1.0",
  "identifier": "ma.symnote.app",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": "python web/build.py --offline",
    "beforeDevCommand": {
      "script": "python web/build.py --offline",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SymNote",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://tauri.localhost ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "CAS notebook with 2D/3D graphics",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
